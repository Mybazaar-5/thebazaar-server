<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BazaarServer</AssemblyName>
    <RootNamespace>BazaarServer</RootNamespace>
    <NoWarn>$(NoWarn);MSB3277;NU1701</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection Condition="'$(ServerGarbageCollection)'==''">true</ServerGarbageCollection>
    <ManagedExtDir Condition="'$(ManagedExtDir)'==''">..\..\ext\Managed</ManagedExtDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BazaarCore\BazaarCore.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <Reference Include="BazaarGameShared"><HintPath>$(ManagedExtDir)\BazaarGameShared.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="BazaarBattleService"><HintPath>$(ManagedExtDir)\BazaarBattleService.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="BazaarGameClient"><HintPath>$(ManagedExtDir)\BazaarGameClient.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="BazaarUnityTools"><HintPath>$(ManagedExtDir)\BazaarUnityTools.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="MessagePack"><HintPath>$(ManagedExtDir)\MessagePack.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="MessagePack.Annotations"><HintPath>$(ManagedExtDir)\MessagePack.Annotations.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedExtDir)\Newtonsoft.Json.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Nanoid"><HintPath>$(ManagedExtDir)\Nanoid.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Gilzoide.SqliteNet"><HintPath>$(ManagedExtDir)\Gilzoide.SqliteNet.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\workshop\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>

