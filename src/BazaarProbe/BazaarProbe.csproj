<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>BazaarProbe</AssemblyName>
    <RootNamespace>BazaarProbe</RootNamespace>
    <NoWarn>$(NoWarn);CS0168;CS0219;MSB3277;NU1701</NoWarn>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <RestorePackages>false</RestorePackages>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BazaarGameShared"><HintPath>..\..\ext\Managed\BazaarGameShared.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="BazaarBattleService"><HintPath>..\..\ext\Managed\BazaarBattleService.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="BazaarGameClient"><HintPath>..\..\ext\Managed\BazaarGameClient.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="MessagePack"><HintPath>..\..\ext\Managed\MessagePack.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="MessagePack.Annotations"><HintPath>..\..\ext\Managed\MessagePack.Annotations.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Nanoid"><HintPath>..\..\ext\Managed\Nanoid.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>..\..\ext\Managed\Newtonsoft.Json.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
