<Project>
  <PropertyGroup>
    <!-- 全仓唯一权威版本号（D7-P1-01），确保 BazaarCore / BazaarServer / BazaarModSdk / BazaarLauncher / BazaarHub 等全工程对齐 -->
    <Version>15.6.0</Version>
    <AssemblyVersion>15.6.0.0</AssemblyVersion>
    <FileVersion>15.6.0.0</FileVersion>
    <InformationalVersion>15.6.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 隔离 BaseIntermediateOutputPath 构建时显式排除项目默认 obj/ 与 bin/，避免双份 AssemblyInfo.cs 触发 CS0579 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
