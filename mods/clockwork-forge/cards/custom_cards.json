      "titleZh": "过载蓄能炉",
      "titleEn": "Z-Sword Custom",
      "descZh": "星港工坊研制的发条蓄能炉，靠左右相邻物品驱动蓄能，攒满 3 层过载后连喷炽焰火球并鼓舞全队。",
      "activeTooltipsZh": [
        "造成 {attr.DamageAmount} 点伤害，并使左右相邻物品各加速 {attr.HasteAmount} 秒"
      ],
      "passiveTooltipsZh": [
        "每当左右相邻物品使用时，本卡充能 {attr.ChargeAmount} 秒并获得 +1 层「过载」",
        "【过载引爆】满 3 层过载时开火：连射 {attr.Custom_0} 发火球（每发 {attr.Custom_1} 伤），其他友军本战 +{attr.Custom_2} 伤害且本卡减 10% 冷却"
      ],
      "enchantTooltipsZh": {
        "Heavy": [
          "触发时使随机一件敌方物品减速 2 秒"
        ],
        "Icy": [
          "触发时冻结随机一件敌方物品 1.5 秒"
        ],
        "Turbo": [
          "触发时额外使左右相邻物品各加速 1.5 秒"
        ],
        "Shielded": [
          "触发时额外获得等同于本卡伤害（{attr.DamageAmount}）的护盾"
        ],
        "Restorative": [
          "触发时额外回复等同于本卡伤害（{attr.DamageAmount}）的生命并净化灼烧/剧毒"
        ],
        "Toxic": [
          "触发时额外对敌方施加 4 层剧毒"
        ],
        "Fiery": [
          "触发时额外对敌方施加 6 层灼烧"
        ],
        "Shiny": [
          "获得 +1 多重施放（每次冷却连发两轮）"
        ],
        "Deadly": [
          "本卡永久获得 +50% 暴击率"
        ],
        "Radiant": [
          "免疫冻结、减速与摧毁"
        ],
        "Obsidian": [
          "本卡基础伤害翻倍（×2）"
        ],
        "Golden": [
          "出售价值翻倍，且每次触发获得 2 金币"
        ],
        "Mossy": [
          "触发时额外获得 5 层再生"
